empt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "type": "RSLT"}, {"questions": [{"responses": [{"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "enpe7n2le02ob07re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": [{"content": "Make your own concept map about the Open Source Movement. ", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}], "id": 11, "type": "DWS"}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "stimuli": [{"_data": [], "type": "welcome", "template_override": 1, "id": 0, "contents": [{}]}, {"template_override": 1, "_data": [], "type": "audio", "title": "", "id": 5, "contents": [{"value": {"coverimg": "enpe7n2le02ob07re2img01.jpg", "images": [{"time": "0", "text": "<strong>John:</strong> Hey, what are you doing?</br>\n<strong>Hanna:</strong> I'm reading about the Open Source Movement. Do you know something about it?</br>\n<strong>John:</strong> No I don't. This is the first time I hear about it.</br>\n<strong>Hanna:</strong> Would you like to learn about it?</br>\n<strong>John:</strong> Yeah, it sounds interesting.</br>\n<strong>Hanna:</strong> Well, the Open Source Movement is an organization that promotes and supports the usage of free license software.</br>", "image": "enpe7n2le02ob07re2img01.jpg", "id": 0}, {"time": "24000", "text": "<strong>John:</strong> So, they promote the acquisition of software without paying it for it, and without the limitation of copyright.</br>\n<strong>Hanna:</strong> It's even more than that. The open source goes beyond the mere acquisition of the software, but the freedom to access and modify its code. So, it allows users to work on it to fix mistakes, add some features, and create variations of a piece of software. </br>\n<strong>John:</strong> When was its creation?</br>\n<strong>Hanna:</strong> In 1998 by Eric S. Raymond. There were other cofounders but Raymond connects the most with the movement because he's the main theorist on the matter. Anyway, he doesn't like to consider himself as the one and only leader. </br>", "image": "enpe7n2le02ob07re2img02.jpg", "id": 1}, {"time": "68000", "text": "<strong>John:</strong> What are the accomplishments they got  so far?</br>\n<strong>Hanna:</strong> Well, they established the Open Source Initiative, which is the administrative organization of the movement; and they got the attention of some software development companies, which helped some open source software to gain recognition; Linux is a good example of it. They're also, along with the SFS, one of the main defenders of the hacker community.</br>\n<strong>John:</strong> Wow! They're totally awesome. I didn't know a thing about them but now, I definitely want to get to know some of that kind of software. Don't you want to do the same?</br>\n<strong>Hanna:</strong> Of course! In fact, would you like to go to the computer lab right now? They just installed Linux on the computers.</br>\n<strong>John:</strong> Let's go!", "image": "enpe7n2le02ob07re2img03.jpg", "id": 2}], "audiosrc": "enpe7n2le02ob07re2aud01"}, "type": "slideshow"}]}], "id": 0, "type": "scholar"}]}